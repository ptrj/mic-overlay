set(CPACK_PACKAGE_NAME "mic-overlay")
set(CPACK_VERBATIM_VARIABLES ON)
set(CPACK_PACKAGE_VERSION "${PROJECT_VERSION}")
set(CPACK_PACKAGE_DESCRIPTION_SUMMARY "Microphone mute status overlay for KDE Wayland")
set(CPACK_PACKAGE_DESCRIPTION "Native Qt6/LayerShellQt overlay observing the default PipeWire microphone. Requires a KDE Plasma Wayland session.")
set(CPACK_PACKAGE_VENDOR "ptrj")
set(CPACK_PACKAGE_CONTACT "ptrj <aur@dbs.sk>")
set(CPACK_PACKAGE_HOMEPAGE_URL "${PROJECT_HOMEPAGE_URL}")
set(CPACK_RESOURCE_FILE_LICENSE "${PROJECT_SOURCE_DIR}/LICENSE")
set(CPACK_PACKAGING_INSTALL_PREFIX "/usr")
set(CPACK_GENERATOR "TGZ")
set(CPACK_STRIP_FILES ON)
set(CPACK_DEBIAN_FILE_NAME DEB-DEFAULT)
set(CPACK_DEBIAN_PACKAGE_SECTION "sound")
set(CPACK_DEBIAN_PACKAGE_RELEASE "1")
set(CPACK_DEBIAN_PACKAGE_SHLIBDEPS ON)
# QML imports and dynamically loaded plugins are not found by dpkg-shlibdeps.
set(CPACK_DEBIAN_PACKAGE_DEPENDS "liblayershellqtinterface6 (>= 6.6), layer-shell-qt (>= 6.6), qt6-wayland, libqt6svg6, qt6-svg-plugins, qml6-module-qtquick, qml6-module-qtquick-window, qml6-module-qtquick-layouts, qml6-module-qtqml-workerscript, pipewire-bin, wireplumber")
set(CPACK_RPM_FILE_NAME RPM-DEFAULT)
set(CPACK_RPM_PACKAGE_RELEASE "1")
set(CPACK_RPM_PACKAGE_LICENSE "GPL-3.0-only")
set(CPACK_RPM_PACKAGE_GROUP "Applications/Multimedia")
# CPack has no dedicated Packager option; extend the generated RPM header.
set(CPACK_RPM_SPEC_MORE_DEFINE "Packager: ${CPACK_PACKAGE_CONTACT}")
set(CPACK_RPM_PACKAGE_AUTOREQPROV ON)
set(CPACK_RPM_PACKAGE_REQUIRES "layer-shell-qt >= 6.6, qt6-qtwayland, qt6-qtsvg, qt6-qtdeclarative, pipewire-utils, wireplumber")
set(CPACK_SOURCE_GENERATOR "TGZ")
set(CPACK_SOURCE_PACKAGE_FILE_NAME "mic-overlay-${PROJECT_VERSION}")
set(CPACK_SOURCE_IGNORE_FILES
    "/build[^/]*/;/\\.git/;/\\.agents/;/\\.codex/;/\\.artifacts/;/config\\.local\\.ini$;/\\.SRCINFO$;~$")
set(CPACK_PROJECT_CONFIG_FILE "${PROJECT_SOURCE_DIR}/cmake/CPackOptions.cmake")
include(CPack)
